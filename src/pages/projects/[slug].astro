---
import Base from '@/layouts/Base.astro';
import Tags from '@/components/Tags.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/lib/date';
import type { Project } from '@/types';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: (entry.data as unknown as Project).id },
    props: { project: entry.data as unknown as Project },
  }));
}

const { project } = Astro.props;

const hasLinks = project.links && project.links.length > 0;
const hasExternalLink = Boolean(project.url) || Boolean(project.github);
---

<Base
  title={project.title}
  description={project.description}
  path={`/projects/${project.id}`}
  type="article"
  publishedTime={project.date ? `${project.date}T00:00:00Z` : undefined}
  narrow
>
  <article>
    <div class="project-hero">
      <header class="article-head">
        <p class="kicker meta">{project.date ? formatDate(project.date) : ''}</p>
        <h1>{project.title}</h1>
        {project.description && <p class="lede">{project.description}</p>}
        <div class="byline">
          {project.type && <span class="tag">{project.type}</span>}
          {project.status && <span class="meta">{project.status}</span>}
        </div>
        {project.tags && project.tags.length > 0 && (
          <div style="margin-top:1rem"><Tags tags={project.tags} /></div>
        )}
        {hasExternalLink && (
          <div class="link-row" style="margin-top:1.25rem">
            {project.url && <a href={project.url} rel="noopener" target="_blank">Live demo ↗</a>}
            {project.github && <a href={project.github} rel="noopener" target="_blank">Source code ↗</a>}
            {project.links?.map((link) => (
              <a class="store-link" href={link.url} rel="noopener" target="_blank">
                {link.label} ↗
              </a>
            ))}
          </div>
        )}
      </header>

      {project.image && (
        <figure class="project-hero-img">
          <a href={project.url || project.github} rel="noopener" target="_blank">
            <img src={project.image} alt={project.title} loading="lazy" />
          </a>
        </figure>
      )}
    </div>

    <div class="prose">
      {project.overview && (
        <>
          <h2>About</h2>
          <p>{project.overview}</p>
        </>
      )}

      {project.what_i_built && project.what_i_built.length > 0 && (
        <>
          <h2>What I built</h2>
          <ul>
            {project.what_i_built.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}

      {project.technologies && project.technologies.length > 0 && (
        <>
          <h2>Technology</h2>
          <p>{project.technologies.join(', ')}</p>
        </>
      )}

      {!project.overview &&
        !project.what_i_built &&
        !project.technologies &&
        !hasLinks && (
          <p class="muted">
            More details coming soon. A longer case study for this project
            isn't written yet, so the essentials above are the whole story for
            now.
          </p>
        )}
    </div>

    <hr />
    <p>
      <a class="more-link" href="/projects">All projects →</a>
    </p>
  </article>
</Base>