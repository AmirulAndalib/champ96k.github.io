---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" description="This page could not be found." path="/404" noIndex>
  <section class="page-head">
    <p class="kicker meta">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="lead">
      Either it was moved or it never was. The archive keeps only what's true, and this isn't it.
    </p>
  </section>
  <p>
    <a class="more-link" href="/">Back home →</a>
  </p>
</Base>