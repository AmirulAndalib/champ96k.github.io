---
import Base from '@/layouts/Base.astro';
import WritingListItem from '@/components/WritingListItem.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_NAME } from '@/lib/site';
import type { ProfileData, SocialEntry } from '@/types';

const profileEntry = (await getCollection('profile'))[0];
const profile = profileEntry?.data as unknown as ProfileData | undefined;

const socialEntries = (await getCollection('social')).map(
  (e) => e.data as unknown as SocialEntry
);
const socials = socialEntries.filter((s) => s && s.url);

const writingAll = await getCollection('writing');
const writing = writingAll
  .filter((w) => w.data.draft !== true)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recentWriting = writing.slice(0, 5);

// Top 3 projects (newest first) for mobile summary
const projectsAll = (await getCollection('projects')).map(
  (e) => e.data as any
);
const topProjects = projectsAll
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Unique companies for mobile summary
const careerAll = (await getCollection('career')).map(
  (e) => e.data as any
);
const seenCompanies = new Set<string>();
const uniqueCompanies = careerAll.filter((c) => {
  if (seenCompanies.has(c.company)) return false;
  seenCompanies.add(c.company);
  return true;
});

const avatar = profile?.image ?? '/avatar.svg';
const title = SITE_NAME;
const taglineParagraphs = (profile?.tagline ?? '')
  .split(/\n+/)
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => p.replace(/\bGojek\b/g, '<mark>Gojek</mark>').replace(/\bGoPay\b/g, '<mark>GoPay</mark>'));

// Feather-style stroke icons for the "Find me" row (label -> inner SVG).
const ICONS: Record<string, string> = {
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  x: '<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3Z"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  'stack overflow':
    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  'let me think':
    '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
};
---

<Base
  title={title}
  description={SITE_DESCRIPTION}
  path="/"
>
  <section class="home-hero section-first">
    <div class="home-hero-content">
      <div class="home-hero-text">
        <p class="home-tagline serif">{profile?.headline}</p>
        <div class="home-hero-desc">
          {
            taglineParagraphs.map((paragraph) => (
              <p class="lede" set:html={paragraph} />
            ))
          }
        </div>
      </div>
      <img class="home-avatar" src={avatar} alt={profile?.name ?? 'Tushar Nikam'} width="272" height="272" />
    </div>
  </section>

  <section class="mobile-summary section">
    <div class="mobile-summary-intro">
      <p class="mobile-summary-desc">
        Hello! I'm Tushar and you're currently exploring my tiny corner of the internet.
        I use this space to project my ideas and express my obsessions.
      </p>
      <img class="mobile-summary-avatar" src={avatar} alt={profile?.name ?? 'Tushar Nikam'} width="120" height="120" />
    </div>
    <h2 class="section-title">Summary</h2>
    <ul class="mobile-summary-list">
      <li class="mobile-summary-row">
        Currently I'm working on my <a href="/projects">ideas<svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg></a>
        <span class="inline-logos">
          {topProjects.map((p: any) => (
            <img class="inline-logo" src={p.image} alt={p.title} width="24" height="24" loading="lazy" />
          ))}
        </span>
      </li>
      <li class="mobile-summary-row">
        Previously worked on consumer mobile products, payments, and gaming applications used by millions - 
        <a href="/about"> View<svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg></a>
        <span class="overlapping-logos">
          {uniqueCompanies.map((c: any) => (
            <img class="overlapping-logo" src={c.image} alt={c.company} width="28" height="28" loading="lazy" />
          ))}
        </span>
      </li>
      <li>
        I build developer tools, libraries, Flutter packages, plugins, and products outside of my day job
        <a href="/open-source">View more<svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg></a>
      </li>
      <li>
        I write a pretty smart newsletter called <a href="/writing">Writing<svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg></a>
      </li>
      <li>
        <span class="mobile-age">27</span> years old, based in Bangalore India
      </li>
    </ul>
  </section>

  {socials.length > 0 && (
    <section class="section">
      <h2 class="section-title">Find me</h2>
      <p class="findme-line">
        The easy places to reach me online, in writing more than anywhere.
        <span class="findme-icons">
          {
            socials.map((social) => (
              <a
                href={social.url}
                rel="me noopener"
                target="_blank"
                aria-label={social.label}
                title={social.handle ? `${social.label} (${social.handle})` : social.label}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS[social.label.toLowerCase()] ?? ICONS['link']}
                />
              </a>
            ))
          }
        </span>
      </p>
    </section>
  )}

  {recentWriting.length > 0 && (
    <section class="section">
      <h2 class="section-title">Recent writing</h2>
      <div class="entry-list">
        {
          recentWriting.map((post) => (
            <WritingListItem
              post={{
                id: post.id,
                title: post.data.title,
                description: post.data.description,
                date: post.data.date.toISOString().slice(0, 10),
                tags: post.data.tags,
                type: post.data.type,
              }}
            />
          ))
        }
      </div>
      <p style="margin-top:1.5rem">
        <a class="btn-link" href="/writing">See all writing →</a>
      </p>
    </section>
  )}

  <section class="section">
    <p>
      More about me, my career, education and how I got here, on the{' '}
      <a href="/about">about page →</a>
    </p>
    <p style="margin-top:0.6rem">
      Want to talk about mobile or open source?{' '}
      <a href={`mailto:${profile?.email ?? ''}`}>Email me</a>.
    </p>
  </section>

  <script is:inline>
    (function () {
      var el = document.querySelector('.mobile-age');
      if (!el) return;
      var dob = new Date(1998, 9, 20);
      var now = new Date();
      var age = now.getFullYear() - dob.getFullYear();
      var m = now.getMonth() - dob.getMonth();
      if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
      el.textContent = age;
    })();
  </script>
</Base>