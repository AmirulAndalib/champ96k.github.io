---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Seo from '@/components/Seo.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noIndex?: boolean;
  narrow?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  type,
  publishedTime,
  noIndex,
  narrow = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Tushar Nikam — Writing" href="/rss.xml" />
    <Seo
      {title}
      {description}
      {path}
      {ogImage}
      {type}
      {publishedTime}
      {noIndex}
    />
  </head>
  <body>
    <div class="page">
      <Header />
      <main id="main" class={narrow ? 'page-main layout-narrow' : 'page-main'}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>