# Optional. Reduces the GitHub API rate-limit risk when running `npm run sync:github`.
# Only the following scopes are needed: `public_repo` (read). Create at
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Canonical URL used for sitemap, SEO and absolute links.
# Defaults to https://champ96k.com when unset.
# When deploying to GitHub Pages before DNS is configured, set:
# SITE_URL=https://champ96k.github.io
SITE_URL=